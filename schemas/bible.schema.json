{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writing-board:bible:1",
  "title": "Writing Board bible",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "characters",
    "locations",
    "world_rules",
    "relationships",
    "timeline",
    "glossary",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "summary",
          "appearance",
          "backstory",
          "want",
          "need",
          "voice",
          "speech_mode",
          "facts",
          "extensions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "backstory": {
            "type": "string"
          },
          "want": {
            "type": "string"
          },
          "need": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "speech_mode": {
            "type": "string",
            "enum": [
              "verbal",
              "nonverbal",
              "unspecified"
            ]
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "statement",
                "status",
                "source_ref"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "statement": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "proposed",
                    "sourced",
                    "established"
                  ]
                },
                "source_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "extensions": {
            "type": "object"
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "facts",
          "extensions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "statement",
                "status",
                "source_ref"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "statement": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "proposed",
                    "sourced",
                    "established"
                  ]
                },
                "source_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "extensions": {
            "type": "object"
          }
        }
      }
    },
    "world_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "sourced",
              "established"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_id",
          "to_id",
          "description",
          "status",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "from_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "sourced",
              "established"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "description",
          "character_ids",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "when": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "character_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "language",
          "preferred",
          "notes"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "preferred": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
